# Copy to .env (never commit values). The browser build reads VITE_* only; the API server reads the rest.

# Browser: which provider set the app uses. mock = fully offline. http = call the API server.
VITE_AI_PROVIDER=mock

# API server
ROLEPLAY_API_PORT=8787
# Run each turn classification twice and report agreement (slower, twice the cost, better evidence).
ROLEPLAY_DUAL_PASS=0
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
# One JSON line per LLM call to stdout (job, provider, model, tokens, latency). Set 0 to silence.
LLM_LOG_USAGE=1

# How Claude calls authenticate. No key is required: pick the mode that matches your environment.
#   env      the SDK resolves credentials itself: ANTHROPIC_API_KEY, or ANTHROPIC_AUTH_TOKEN (bearer),
#            or workload identity federation variables, or an Anthropic CLI profile.
#   gateway  no credential leaves this process. ANTHROPIC_BASE_URL points at an internal gateway that
#            authenticates on the network path; auth headers are omitted. LLM_GATEWAY_HEADERS adds any
#            extra headers the gateway wants, as a JSON object.
# Bedrock and Vertex routes use cloud identity (AWS default credential chain, Google application
# default credentials) and ignore the Anthropic variables entirely.
LLM_AUTH_MODE=env
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
LLM_GATEWAY_HEADERS=
# Bedrock: region (or AWS_REGION). Model ids take the anthropic. prefix, e.g. anthropic.claude-opus-5-5
LLM_BEDROCK_REGION=
# Vertex: region (or CLOUD_ML_REGION; "global" is recommended) and project (or ANTHROPIC_VERTEX_PROJECT_ID)
LLM_VERTEX_REGION=
LLM_VERTEX_PROJECT_ID=

# Job routing: provider:model[:effort]. Jobs without a route use LLM_ROUTE_DEFAULT; mock means offline.
# Providers implemented: anthropic (first party API or gateway), bedrock, vertex, mock. openai, google and
# azure-openai are reserved names whose adapters are not yet written; routing to one fails at startup.
# Examples, everything on Claude:
#   via an internal gateway:  LLM_AUTH_MODE=gateway  ANTHROPIC_BASE_URL=https://llm-gateway.internal/anthropic
#                             LLM_ROUTE_DEFAULT=anthropic:claude-opus-5-5
#   via Bedrock (IAM):        LLM_BEDROCK_REGION=us-east-1  LLM_ROUTE_DEFAULT=bedrock:anthropic.claude-opus-5-5
#   via Vertex (ADC):         LLM_VERTEX_REGION=global LLM_VERTEX_PROJECT_ID=my-project  LLM_ROUTE_DEFAULT=vertex:claude-opus-5-5
#   per job effort:           LLM_ROUTE_NPC=anthropic:claude-opus-5-5:low  LLM_ROUTE_CLASSIFY=anthropic:claude-opus-5-5:medium
LLM_ROUTE_DEFAULT=mock
LLM_ROUTE_NPC=
LLM_ROUTE_CLASSIFY=
LLM_ROUTE_REPORT=
# Optional fallback per job when the primary route errors or refuses.
LLM_FALLBACK_NPC=
LLM_FALLBACK_CLASSIFY=
LLM_FALLBACK_REPORT=
# Prompt file version per job, under /prompts/<job>/.
PROMPT_VERSION_NPC=v1
PROMPT_VERSION_CLASSIFY=v1
PROMPT_VERSION_REPORT=v1
